{
  // Cloudflare Workers static-assets config for brendanhoss.com.
  // Serves the Vite production build (./dist) as static assets — no Worker
  // script. The build hook below runs `npm ci && npm run build` automatically as
  // part of `wrangler deploy`, so both local deploys AND the git-connected Workers
  // Builds pipeline produce ./dist before deploying (npm ci: exactly the lockfile,
  // never a silently upgraded dependency). No dashboard build command is required,
  // and a plain `git push` to master deploys the site. The diorama assets are
  // committed (public/assets/v1, built offline by `npm run assets`; validate them
  // with `npm run assets -- --check`): this build never runs Blender or toktx.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-1",
  "compatibility_date": "2026-06-01",
  "build": {
    "command": "npm ci && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
