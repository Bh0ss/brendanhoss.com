{
  // Cloudflare Workers static-assets config for brendanhoss.com.
  // Serves the Vite production build (./dist) as static assets — no Worker
  // script. Workers Builds runs `npm run build` (set as the Build command in
  // the dashboard) to produce ./dist, then deploys these assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-1",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
